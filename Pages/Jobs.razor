
@using MudBlazor
@using BlazorTaskScheduler.Quartz
@inject IQuartzService QuartzService
@page "/jobs"


<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">Scheduled Jobs</MudText>

    @if (jobs == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudTable T="JobDetailData" Items="@jobs" Hover="true" Dense="true" Bordered="true" Striped="true">

            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Group</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Next Run</MudTh>
                <MudTh>Last Run</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <!-- IMPORTANT: Context="job" MUST be here -->
            <RowTemplate Context="job">
                <MudTd>@job.Name</MudTd>
                <MudTd>@job.Group</MudTd>
                <MudTd>@job.Description</MudTd>
                <MudTd>@Format(job.NextRun)</MudTd>
                <MudTd>@Format(job.LastRun)</MudTd>

                <MudTd>
                    <MudChip T="string" Color="@(job.Status == "Paused" ? Color.Warning : Color.Success)">
                        @(job.Status)
                    </MudChip>
                </MudTd>

                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => RunNow(job))">Run</MudButton>
                        @if (job.Status == "Paused")
                        {
                            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" OnClick="@(() => Resume(job))">Resume</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" OnClick="@(() => Pause(job))">Pause</MudButton>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>
                    <MudIconButton Href="@($"/jobs/{job.Group}/{job.Name}")" Icon ="@Icons.Material.Filled.ChevronRight" Size="Size.Small" title="Open job" Color="Color.Primary" />
                </MudTd>

            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    List<JobDetailData> jobs; 

    protected override async Task OnInitializedAsync()
    {
        jobs = await QuartzService.GetJobsAsync();
    }

    string Format(DateTimeOffset? dto)
        => dto?.ToLocalTime().ToString("g") ?? "-";

    async Task RunNow(JobDetailData job)
    {
        await QuartzService.RunJobNow(job.Name, job.Group);
        jobs = await QuartzService.GetJobsAsync();
    }

    async Task Pause(JobDetailData job)
    {
        await QuartzService.PauseJob(job.Name, job.Group);
        jobs = await QuartzService.GetJobsAsync();
    }

    async Task Resume(JobDetailData job)
    {
        await QuartzService.ResumeJob(job.Name, job.Group);
        jobs = await QuartzService.GetJobsAsync();
    }
}
